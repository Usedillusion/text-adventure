DISCORD_TOKEN=your-bot-token
GAMES_DIR=/data/games
SAVES_DIR=/data/saves
# Prefix for game input; set empty (COMMAND_PREFIX=) to treat every message as a command
COMMAND_PREFIX=>
# Optional: guild (server) ID for instant command sync during setup
GUILD_ID=
SESSION_IDLE_MINUTES=30
USE_THREADS=true
DFROTZ_PATH=dfrotz
READ_IDLE_SECONDS=0.4
READ_MAX_SECONDS=8
